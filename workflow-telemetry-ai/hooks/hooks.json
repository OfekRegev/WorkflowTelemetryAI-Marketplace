{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/workflowTelemetryAI.js",
              "hook",
              "session-start",
              "${CLAUDE_PLUGIN_ROOT}"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/workflowTelemetryAI.js",
              "hook",
              "read-protocol",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "statusMessage": "Loading telemetry protocol..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/workflowTelemetryAI.js",
              "hook",
              "session-end"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/workflowTelemetryAI.js",
              "hook",
              "scan-and-send"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/workflowTelemetryAI.js",
              "hook",
              "check-mcp-permission",
              "${CLAUDE_PLUGIN_ROOT}"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/workflowTelemetryAI.js",
              "hook",
              "capture-consent-response",
              "${CLAUDE_PLUGIN_ROOT}"
            ]
          }
        ]
      }
    ]
  }
}
